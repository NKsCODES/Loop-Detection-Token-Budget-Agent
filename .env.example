# Copy to .env and fill in. Every setting can also be passed as an environment variable.

# fake = offline scripted model (no key needed), openai, or anthropic
LOOPGUARD_LLM_PROVIDER=fake
LOOPGUARD_LLM_MODEL=
# Any OpenAI-compatible server (vLLM, Ollama, Groq): set the base URL
LOOPGUARD_LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Persistence: SQLite for dev, PostgreSQL for prod
LOOPGUARD_DATABASE_URL=sqlite:///./data/loopguard.db
LOOPGUARD_CHECKPOINT_URL=sqlite:///./data/checkpoints.db

# Protect /v1 endpoints with header X-API-Key
LOOPGUARD_API_KEY=

# Guard thresholds
LOOPGUARD_GUARD__MAX_STEPS=20
LOOPGUARD_GUARD__MAX_CALLS_PER_TOOL=8
LOOPGUARD_GUARD__MAX_IDENTICAL_CALLS=3
LOOPGUARD_GUARD__MAX_SAME_OUTPUT=3
LOOPGUARD_GUARD__TOKEN_BUDGET=20000
LOOPGUARD_GUARD__COST_BUDGET_USD=0.25

# Price per one million tokens for cost tracking. Set to your model's current list price.
LOOPGUARD_PRICING__INPUT_PER_MILLION=3.0
LOOPGUARD_PRICING__OUTPUT_PER_MILLION=15.0

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=loopguard
